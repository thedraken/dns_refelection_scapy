# Use an official Python runtime as a parent image
FROM python:3.9-slim

# Set the working directory in the container
WORKDIR /usr/src/app

# Install Scapy
RUN pip install --no-cache-dir scapy

# Install libpcap (needed for Scapy BPF filters) + handy tools
RUN apt-get update && apt-get install -y libpcap-dev tcpdump iputils-ping && rm -rf /var/lib/apt/lists/*

# Command to run when the container starts
CMD ["bash"]
